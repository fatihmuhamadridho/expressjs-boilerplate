{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@common/*": ["src/common/*"],
      "@features/*": ["src/features/*"]
    },
    "rootDir": ".",
    "outDir": "./dist",
    "ignoreDeprecations": "6.0"
  },
  "include": ["./prisma.config.ts", "./src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
